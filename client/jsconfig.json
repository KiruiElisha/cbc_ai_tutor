{
  "compilerOptions": {
    "moduleResolution": "bundler",
    "target": "ESNext",
    "module": "ESNext",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "checkJs": false,
    "types": ["svelte", "vite/client"]
  },
  "include": ["src/**/*.js", "src/**/*.svelte"]
}
